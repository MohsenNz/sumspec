-- PMode.ShowMission

editSelectedMission
  :: Page.Plan
  => PMode.ShowMission.Selected(MissionState.NotStarted * At)
   * Missions(Mission(At * Plot))
  -> PMode.Plot(PlotOrigin.Editing * Plot')
  @control button_icon_f

copyMission MissionName
  :: Page.Plan
  => PMode.ShowMission.Selected
  -> PMode.ShowMission.Selected(MissionState.NotStarted) * Missions'
  @control name_prompt

selectMission At
  :: PMode.ShowMission.List.NonEmpty -> PMode.ShowMission.Selected(At)
  @control list_row

deleteMission
  :: Page.Plan
  => PMode.ShowMission.Selected
  -> PMode.ShowMission.List * Missions'
  @control button_icon_f
  @requiresConfirmation

backToList :: PMode.ShowMission.Selected -> PMode.ShowMission.List.NonEmpty
  @control button_icon  -- inside panel

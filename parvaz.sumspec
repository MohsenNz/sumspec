-- AircraftCanvas

maximizeCamera :: AircraftCanvas => FCamera.Minimized -> FCamera.Maximized
  @control button_icon_f

minimizeCamera :: AircraftCanvas => FCamera.Maximized -> FCamera.Minimized
  @control button_icon_f

hideCamera     :: AircraftCanvas => FCamera(Minimized | Maximized) -> FCamera.Hidden
  @control button_icon_f

unhideCamera   :: AircraftCanvas => FCamera.Hidden -> FCamera.Minimized
  @control button_icon_f

panMap         :: AircraftCanvas => MapFollow -> MapFollow.Free
  @control map_pan

recenterMap    :: AircraftCanvas => MapFollow.Free -> MapFollow.Following
  @control button_icon_f



types
  About : sum of Closed, Open
  AircraftCanvas : product of FCamera, MapFollow
  AircraftGauges : product of core.Satellites, core.SprayFlow, core.Altitude, core.RangefinderAlt, core.OffsetAlt, core.Speed, core.Heading, core.Battery, from core.AircraftStatus
  AircraftIndicators : product of core.ArmState, core.FlightMode, core.GPSFix, from core.AircraftStatus
  AircraftPanel : sum of Disconnected, Connected, from core.Core(core.AircraftLink)
  AircraftPose : product of core.Latitude, core.Longitude, core.Heading, core.GPSFix, from core.AircraftStatus
  AircraftView : product of AircraftPanel, AircraftCanvas, BatteryFigure
  App : product of Page, Map, core.Core
  AppVersion : newtype of core.Text
  Battery : newtype of core.BatteryCharge, from core.AircraftStatus(core.Battery)
  BatteryFigure : sum of Voltage, Charge
  CornerPick : sum of Idle, Picking
  DeviceForm : product of DeviceOrigin, core.DeviceName, LinkKind, Host, core.Port, core.Baud
  DeviceListing : product of DeviceRows, LinkStatus
  DeviceLocation : sum of Unknown, Locating, Denied, Failed, Located
  DeviceOrigin : sum of New, Existing
  DeviceRow : product of core.DeviceName, core.LinkSettings, core.LastSystemId, from core.Device
  DeviceRows : list of DeviceRow by core.DeviceId, from core.Core(core.Devices)
  DevicesPage : sum of Listing, Editing
  EdgePick : sum of Idle, Picking, Selected
  FCamera : sum of Maximized, Minimized, Hidden
  HomeAircraft : sum of Disconnected, Connected, from core.Core(core.AircraftLink)
  HomeIndicators : product of core.GPSFix, core.Satellites, core.ArmState, from core.AircraftStatus
  HomeMarker : newtype of core.HomePoint, from core.Aircraft
  HomePage : product of About, LinkStatus, HomeAircraft
  Host : sum of Unset, Named
  LinkKind : sum of Udp, Tcp, Serial
  LinkStatus : product of core.LinkSession, core.AircraftLink, from core.Core
  LogLevelFilter : sum of All, Warnings, Errors
  LogList : list of core.LogEntry, from core.Core(core.Logs)
  LogTagFilter : list of core.LogTag
  LogsPage : product of LogLevelFilter, LogTagFilter, LogList
  Map : product of TileStatus, Zoom, DeviceLocation
  MapFollow : sum of Following, Free
  MissionPanel : sum of List, Selected
  MissionRow : product of core.MissionName, core.MissionState, core.GroundMeasurements, from core.Mission
  MissionRows : list of MissionRow by core.At, from core.Core(core.Missions)
  NewName : product of core.At, core.MissionName
  Page : sum of Home, Plan, Devices, Logs
  PlanPage : sum of JustMap, Plot, ShowMission, MissionRun, ManualAircraft
  PlotController : sum of Field, Route
  PlotEditor : product of PlotOrigin, core.Plot, PointHistory, PlotController, ShapeSelection, CornerPick, EdgePick
  PlotOrigin : sum of Draft, Editing
  PointHistory : product of Undo, Redo
  PointSelection : sum of Empty, Selected
  PointType : sum of BoundaryPoint, Obstacle, RoundObstacle, PowerLine, NonSprayArea, MarkPoint
  Redo : sum of Ready, Empty
  RunPanel : sum of Idle, Active, from core.Core(core.Run)
  RunView : product of RunPanel, AircraftPanel, AircraftCanvas, BatteryFigure
  Shape : sum of Boundary, Marking
  ShapeSelection : sum of Empty, Selected
  TileStatus : sum of Loading, Ready, Offline
  Undo : sum of Ready, Empty
  Zoom : newtype of core.Int
  core.Aircraft : product of core.AircraftStatus, core.Feed, core.HomePoint, core.BatteryReserve, core.SystemId
  core.AircraftLink : sum of Disconnected, Connected
  core.AircraftStatus : product of core.ArmState, core.FlightMode, core.GPSFix, core.Satellites, core.Battery, core.SprayFlow, core.Altitude, core.RangefinderAlt, core.OffsetAlt, core.Speed, core.Heading, core.Latitude, core.Longitude
  core.Altitude : newtype of core.Meters
  core.Area : newtype of core.Hectares
  core.ArmState : sum of Disarmed, Armed
  core.At : newtype of core.Timestamp
  core.Battery : product of core.BatteryVoltage, core.BatteryCharge
  core.BatteryCharge : newtype of core.Percent
  core.BatteryReserve : sum of Enough, Low
  core.BatteryVoltage : newtype of core.Volts
  core.Baud : newtype of core.Int
  core.Boundary : newtype of core.Ring
  core.BreakPoint : newtype of core.Point
  core.CopyOf : newtype of core.At
  core.Core : product of core.Missions, core.Run, core.AircraftLink, core.Devices, core.LinkSession, core.LastDevice, core.Logs
  core.Course : sum of Auto, Manual
  core.CourseAngle : newtype of core.Degrees
  core.CoverageArea : sum of RouteOnly, RouteAndBoundary, BoundaryOnly
  core.DefaultEdgeMargin : newtype of core.Meters
  core.Degrees : atomic __float
  core.Device : product of core.DeviceName, core.LinkSettings, core.LastSystemId
  core.DeviceId : newtype of core.Timestamp
  core.DeviceName : newtype of core.Text
  core.Devices : list of core.Device by core.DeviceId
  core.Distance : newtype of core.Meters
  core.Edge : newtype of core.Point
  core.EdgeInset : newtype of core.Meters
  core.EdgeMargin : product of core.Edge, core.EdgeInset
  core.EdgeMargins : list of core.EdgeMargin
  core.FPhase : sum of Approaching, Spraying, Holding, PilotControl, Returning
  core.FailureReason : atomic __text
  core.Feed : sum of Live, Stale
  core.FlightMode : sum of Unknown, Named
  core.FlownTo : product of core.At, core.Point
  core.GPSFix : sum of NoFix, Fix2D, Fix3D, DGPS, RTKFix
  core.GroundMeasurements : product of core.Distance, core.Area, core.RouteProgress
  core.Heading : newtype of core.Degrees
  core.Hectares : atomic __float
  core.HomePoint : sum of Unknown, Known
  core.HostName : newtype of core.Text
  core.Int : atomic __int
  core.LastDevice : sum of None, Known
  core.LastSystemId : sum of Unheard, Heard
  core.Latitude : atomic __float
  core.LinkFailure : newtype of core.Text
  core.LinkQuality : newtype of core.Percent
  core.LinkSession : sum of Closed, Open, Failed
  core.LinkSettings : sum of Udp, Tcp, Serial
  core.LitersPerMin : atomic __float
  core.LogEntry : product of core.Timestamp, core.LogLevel, core.LogTag, core.Text
  core.LogLevel : sum of Info, Warning, Error
  core.LogTag : sum of Link, Mavlink, Vehicle, Storage, Basemap, Crash
  core.Logs : list of core.LogEntry
  core.Longitude : atomic __float
  core.Marking : sum of Obstacle, RoundObstacle, PowerLine, NonSprayArea, MarkPoint
  core.Markings : list of core.Marking
  core.Meters : atomic __float
  core.MetersPerSec : atomic __float
  core.Mission : product of core.MissionName, core.GroundMeasurements, core.MissionState, core.Plot
  core.MissionCopy : product of core.CopyOf, core.At, core.MissionName
  core.MissionFlight : sum of Arming, Flying, Failed
  core.MissionName : newtype of core.Text
  core.MissionRun : product of core.At, core.MissionFlight
  core.MissionState : sum of NotStarted, Completed, Stopped
  core.Missions : list of core.Mission by core.At
  core.NewMission : product of core.At, core.MissionName, core.Plot
  core.ObstacleBoundary : newtype of core.Meters
  core.OffsetAlt : sum of NoSensor, NoReading, Reading
  core.Path : sum of Partial, Total
  core.Percent : atomic __float
  core.Plot : sum of Empty, Drawn
  core.PlotDrawn : product of core.Boundary, core.Markings, core.RouteSettings
  core.PlotUpdate : product of core.At, core.MissionName, core.Plot
  core.Point : product of core.Latitude, core.Longitude
  core.Points : list of core.Point
  core.Port : newtype of core.Int
  core.RangefinderAlt : sum of NoSensor, NoReading, Reading
  core.ReturnHeight : newtype of core.Meters
  core.Ring : sum of Partial, Closeable, Enclosed
  core.RouteEntry : sum of FromStart, FromBreakPoint
  core.RouteProgress : newtype of core.Percent
  core.RouteSettings : product of core.RouteSpacing, core.SprayHeight, core.ReturnHeight, core.SpraySpeed, core.DefaultEdgeMargin, core.EdgeMargins, core.StartCorner, core.CoverageArea, core.ObstacleBoundary, core.SingleSideSpraying, core.Course
  core.RouteSpacing : newtype of core.Meters
  core.Run : sum of Idle, Active
  core.Satellites : newtype of core.Int
  core.SavedDevice : product of core.DeviceId, core.DeviceName, core.LinkSettings
  core.Seconds : atomic __float
  core.SingleSideSpraying : sum of Off, On
  core.Speed : newtype of core.MetersPerSec
  core.Spot : newtype of core.Point
  core.SprayFlow : newtype of core.LitersPerMin
  core.SprayHeight : newtype of core.Meters
  core.SpraySpeed : newtype of core.MetersPerSec
  core.Sprayer : newtype of core.Unimplemented
  core.StartCorner : newtype of core.Point
  core.StopReason : sum of Commanded, BatteryLow, LinkLost, ManualTakeover, GpsLost
  core.SystemId : newtype of core.Int
  core.TelemetryAge : newtype of core.Seconds
  core.Text : atomic __text
  core.Timestamp : atomic
  core.Unimplemented : atomic
  core.Volts : atomic __float

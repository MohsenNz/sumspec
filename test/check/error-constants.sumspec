-- Constants that break the rules.
__atomics {
  Percent = __float
  Count = __int
  Name = __text
  Tag
  Taken = __int
}
__events { go compare input arg dotted }

__init :: App

App = Percent * Count * Name * Gps * Box
Box = Percent * Count
Shape = Circle Percent | Square
Gps = NoFix | Fix3D

__const Decimal = Count(1.5)
__const Text = Percent("a")
__const Number = Name(3)
__const Opaque = Tag(1)
__const Enum = Gps(1)
__const Unknown = Missing(1)
__const Product = Box(1)
__const BadVariant = Gps.Missing
__const PayloadVariant = Shape.Circle
__const NotASum = Count.Zero
__const UnknownSum = Missing.Zero
__const Twice = Count(1)
__const Twice = Count(2)
__const Gps = Count(3)
__const Taken = Count(4)
__const Cycle = Count(1)
Alias = Cycle
__const Fine = Count(7)

Wrapped = Fine
Factor = Percent * Fine
Payload = Wrap Fine | Other
Boxed = Percent * Cycle

go :: Fine -> Fine
compare :: App => Count#k // k > Cycle and Cycle == Fine -> Count'

Listed = [Fine]
Keyed = [Count by Fine]

input Fine :: Count -> Count'
arg :: App(Fine) -> App(Count')
dotted :: App => Count#k // k == Fine.Foo -> Count'

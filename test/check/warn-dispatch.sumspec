-- Warning: a dispatch whose event has a reaction that can apply in the
-- same state.
__imports {
  core "base-todo.sumspec"
}

__atomics { }
__events { stopClicked }

__init :: App(Mode.Off)

App = Mode * core.Core
Mode = On | Off

-- Both are on App and can apply to the same state.
stopClicked :: App(core.Core(core.Link.Up) * Mode.Off) -> App  >> core.stop
core.stop :: App => Mode.Off -> Mode.On

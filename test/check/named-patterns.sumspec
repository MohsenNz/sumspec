-- Named patterns, expanded before checking: in a source, a target, a
-- guard and __init; a path (__path) before =>; a parameter as an element key; a
-- pattern used in another's body; several factors in one argument.
__atomics { Name = __text  Id }
__events { rename open close pick reset connect }

App = Page * Items * Link
Page = Home | Editor (Doc * Mode)
Doc = Title * Body
Title = Name
Body = Name
Mode = Viewing | Editing
Items = [Item by Id]
Item = Done | Todo
Link = Off | On

__pattern Start = App(Page.Home * Link.Off)
__path Ed = App / Page.Editor
__pattern InEditor(x) = App(Page.Editor(x))
__pattern Edit(d, m) = InEditor(d * m)
__pattern Picked(i, s) = App(Items[i](s))
__pattern Online = App(Link.On)

__init :: Start

rename Name#n
  :: InEditor(Doc(Title#t) * Mode.Editing) // not Online
  -> InEditor(Doc(Title(n)))
open :: App(Page.Home) -> Edit(Doc, Mode.Viewing)
close :: Ed => Mode.Viewing -> Mode.Editing
pick Id#i :: Picked(i, Item.Todo) -> Picked(i, Item.Done)
reset :: Ed => Mode.Editing -> Mode.Viewing
connect :: App => Link.Off -> Link.On
